-- ---------- Fling (multi-target) ----------
do
	local flingStatusLabel = addNote(flingPage, "0 target(s) selected")

	updateFlingStatus = function()
		local count = 0
		for _ in pairs(selectedTargets) do count = count + 1 end
		if flingActive then
			flingStatusLabel.Text = "Flinging " .. count .. " target(s)!"
			flingStatusLabel.TextColor3 = Color3.fromRGB(255, 120, 120)
		else
			flingStatusLabel.Text = count .. " target(s) selected"
			flingStatusLabel.TextColor3 = THEME.sub
		end
	end

	local flingCountUI = 200
	local function nextOrder()
		flingCountUI = flingCountUI + 1
		return flingCountUI
	end

	-- target checkbox list
	local targetsSection = addSection(flingPage, "Targets")
	targetsSection.LayoutOrder = 99

	updateFlingList = function()
		for _, child in ipairs(flingPage:GetChildren()) do
			if child.Name == "FlingPlayerBtn" then child:Destroy() end
		end

		local list = Players:GetPlayers()
		table.sort(list, function(a, b) return a.Name:lower() < b.Name:lower() end)

		local listIndex = 0
		for _, plr in ipairs(list) do
			if plr ~= player then
				local selected = selectedTargets[plr.Name] ~= nil
				listIndex = listIndex + 1
				local btn = Instance.new("TextButton")
				btn.Name = "FlingPlayerBtn"
				btn.LayoutOrder = 100 + listIndex
				btn.Size = UDim2.new(1, 0, 0, 36)
				btn.BackgroundColor3 = selected and THEME.accent or THEME.panel
				btn.TextColor3 = selected and Color3.new(1, 1, 1) or THEME.sub
				btn.Font = Enum.Font.GothamMedium
				btn.TextSize = 14
				btn.Text = (selected and "✓  " or "       ") .. plr.DisplayName
				btn.AutoButtonColor = false
				btn.Parent = flingPage
				corner(btn, 8)
				btn.MouseEnter:Connect(function()
					if not selected then tween(btn, {BackgroundColor3 = THEME.panelHover}) end
				end)
				btn.MouseLeave:Connect(function()
					if not selected then tween(btn, {BackgroundColor3 = THEME.panel}) end
				end)
				btn.MouseButton1Click:Connect(function()
					if selectedTargets[plr.Name] then
						selectedTargets[plr.Name] = nil
					else
						selectedTargets[plr.Name] = plr
					end
					updateFlingList()
					updateFlingStatus()
				end)
			end
		end
		updateFlingStatus()
	end

	-- START FLING / STOP FLING
	local function addFlingRow(leftText, leftColor, leftCallback, rightText, rightColor, rightCallback)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, 0, 0, 40)
		row.BackgroundTransparency = 1
		row.LayoutOrder = nextOrder()
		row.Parent = flingPage

		local function half(text, xOffset, color, callback)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(0.5, -6, 1, 0)
			b.Position = UDim2.new(xOffset, xOffset == 0 and 0 or 6, 0, 0)
			b.BackgroundColor3 = color
			b.Text = text
			b.TextColor3 = Color3.new(1, 1, 1)
			b.Font = Enum.Font.GothamBold
			b.TextSize = 14
			b.AutoButtonColor = true
			b.Parent = row
			corner(b, 8)
			local g = Instance.new("UIGradient")
			g.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(180, 180, 200)),
			})
			g.Rotation = 90
			g.Parent = b
			b.MouseButton1Click:Connect(callback)
		end

		half(leftText, 0, leftColor, leftCallback)
		half(rightText, 0.5, rightColor, rightCallback)
	end

	local controlsSection = addSection(flingPage, "Controls")
	controlsSection.LayoutOrder = nextOrder()

	addFlingRow(
		"START FLING", Color3.fromRGB(0, 170, 70), startFling,
		"STOP FLING", Color3.fromRGB(190, 40, 40), stopFling
	)

	local allSection = addSection(flingPage, "Select")
	allSection.LayoutOrder = nextOrder()

	addFlingRow(
		"SELECT ALL", THEME.panel, function()
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= player then selectedTargets[plr.Name] = plr end
			end
			updateFlingList()
		end,
		"SELECT NONE", THEME.panel, function()
			selectedTargets = {}
			updateFlingList()
		end
	)

	local flingHint = addNote(flingPage, "Pick targets above, then press START FLING to keep launching them until you press STOP FLING. You keep walking freely while it flings.")
	flingHint.LayoutOrder = nextOrder()

	updateFlingList()
end

-- ---------- Players (teleport) ----------
addSection(playersPage, "Teleport to player")

local function teleportTo(target)
	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local theirRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
	if myRoot and theirRoot then
		myRoot.CFrame = theirRoot.CFrame + Vector3.new(0, 3, 0)
	end
end

local function refreshList()
	for _, child in ipairs(playersPage:GetChildren()) do
		if child.Name == "PlayerBtn" then child:Destroy() end
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local btn = Instance.new("TextButton")
			btn.Name = "PlayerBtn"
			btn.Size = UDim2.new(1, 0, 0, 36)
			btn.BackgroundColor3 = THEME.panel
			btn.TextColor3 = THEME.text
			btn.Font = Enum.Font.GothamMedium
			btn.TextSize = 14
			btn.Text = plr.DisplayName
			btn.AutoButtonColor = false
			btn.Parent = playersPage
			corner(btn, 8)
			btn.MouseEnter:Connect(function() tween(btn, {BackgroundColor3 = THEME.accent}) end)
			btn.MouseLeave:Connect(function() tween(btn, {BackgroundColor3 = THEME.panel}) end)
			btn.MouseButton1Click:Connect(function()
				teleportTo(plr)
			end)
		end
	end
end

-- ======================================================
-- PLAYER EVENTS
-- ======================================================
local function watchPlayer(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(0.5)
		if espEnabled then applyESP(plr) end
	end)
end

for _, plr in ipairs(Players:GetPlayers()) do
	watchPlayer(plr)
end

Players.PlayerAdded:Connect(function(plr)
	watchPlayer(plr)
	refreshList()
	updateFlingList()
end)

Players.PlayerRemoving:Connect(function(plr)
	clearESP(plr)
	selectedTargets[plr.Name] = nil
	task.defer(function()
		refreshList()
		updateFlingList()
	end)
end)

refreshList()
showPage("Visuals")
